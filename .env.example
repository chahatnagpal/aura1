# Your unique Supabase Project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Public Supabase Anon API Key (safe for browser client)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# IMPORTANT SECURITY NOTE:
# Never put your private/secret `service_role` key in frontend client code!
